NODE_ENV=production
PORT=3035
APP_URL=https://cv.example.com
DATABASE_URL=postgresql://lamariva:CHANGE_ME@127.0.0.1:5432/lamariva
AUTH_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lamariva <info@example.com>"
STORAGE_PATH=./storage
JOB_SYNC_ENABLED=true
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
BACKUP_DIR=/var/backups/lamariva
BACKUP_RECIPIENT=
BACKUP_RETENTION_DAYS=14
BACKUP_NOTIFY_EMAIL=
NEXT_TELEMETRY_DISABLED=1
